{
  "schema_version": 1,
  "id": "C851_invalid__optional_data_nondummy",
  "rule": "C851",
  "facets": [
    "nondummy-exclusion"
  ],
  "evidence": "effect",
  "standard": "f2023",
  "files": [
    "source.f90"
  ],
  "build": [
    {
      "id": "source",
      "source": "source.f90",
      "language": "fortran",
      "form": "free",
      "output": "source.o"
    }
  ],
  "expect": {
    "phase": "compile",
    "step": "source",
    "outcome": "diagnose",
    "diagnostic": {
      "file": "source.f90",
      "line": 3,
      "end_line": 3,
      "equals_any": [
        "Symbol at (1) is not a DUMMY variable",
        "Only a dummy argument should have an INTENT, VALUE, or OPTIONAL attribute [-Wignore-irrelevant-attributes]"
      ],
      "excludes_any": [
        "not yet implemented",
        "not implemented",
        "unimplemented",
        "unsupported",
        "not supported",
        "internal:",
        "internal error",
        "asr",
        "verifier",
        "out of memory",
        "recovery",
        "cannot read module",
        "missing interface",
        "syntax error",
        "malformed"
      ],
      "allow_nonfatal": [
        {
          "compiler": "flang",
          "severity": "warning",
          "equals_any": [
            "Only a dummy argument should have an INTENT, VALUE, or OPTIONAL attribute [-Wignore-irrelevant-attributes]"
          ]
        }
      ]
    }
  }
}
