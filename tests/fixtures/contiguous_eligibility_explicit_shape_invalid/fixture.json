{
  "schema_version": 1,
  "id": "C830_invalid__contiguous_eligibility_explicit_shape",
  "rule": "C830",
  "facets": [
    "explicit-shape-excluded"
  ],
  "standard": "f2023",
  "evidence": "effect",
  "files": [
    "source.f90"
  ],
  "build": [
    {
      "id": "source",
      "source": "source.f90",
      "language": "fortran",
      "form": "free",
      "output": "source.o"
    }
  ],
  "expect": {
