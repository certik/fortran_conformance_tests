        "not implemented",
        "unimplemented",
        "unsupported",
        "not supported",
        "internal:",
        "internal error",
        "asr",
        "verifier",
        "out of memory",
        "recovery",
        "kind",
        "initialization",
        "initializer",
        "syntax error",
        "malformed",
        "duplicate",
        "cannot read module",
        "missing interface"
      ],
      "allow_nonfatal": [
        {
          "compiler": "flang",
          "severity": "portability",
          "equals_any": [
            "CONTIGUOUS entity 'subject' should be an array pointer, assumed-shape, or assumed-rank [-Wredundant-contiguous]"
